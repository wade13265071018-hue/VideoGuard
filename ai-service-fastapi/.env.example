# Copy this file to .env and fill in real credentials locally.
# Do not commit .env.

VIDEOGUARD_ASR_ENABLED=true

# local: faster-whisper
# tencent: Tencent Cloud recording file recognition
VIDEOGUARD_ASR_PROVIDER=tencent

# Local faster-whisper fallback settings
VIDEOGUARD_ASR_MODEL=tiny
VIDEOGUARD_ASR_DEVICE=cpu
VIDEOGUARD_ASR_COMPUTE_TYPE=int8
VIDEOGUARD_ASR_LANGUAGE=zh

# Tencent Cloud ASR settings
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_REGION=ap-shanghai
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_AUDIO_BITRATE=64k
TENCENT_ASR_TIMEOUT_SEC=180
TENCENT_ASR_POLL_INTERVAL_SEC=3

# Optional Tencent temporary hotwords, format: word|weight,word|weight
# Higher weights increase recognition priority. 11 is a super hotword.
TENCENT_ASR_HOTWORD_LIST=

# Optional post-ASR correction pairs, format: wrong=>right,wrong=>right
TENCENT_ASR_CORRECTIONS=

# Aliyun provider settings
# Set VIDEOGUARD_ASR_PROVIDER=aliyun to use DashScope ASR.
# Set VIDEOGUARD_VIDEO_DETECT_PROVIDER=aliyun to use Alibaba Cloud video moderation.
DASHSCOPE_API_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION_ID=cn-beijing
ALIYUN_OSS_BUCKET=videoguard
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_SIGNED_URL_EXPIRES=3600
ALIYUN_ASR_MODEL=paraformer-v2
ALIYUN_ASR_AUDIO_BITRATE=96k
ALIYUN_ASR_TIMEOUT_SEC=300
ALIYUN_ASR_POLL_INTERVAL_SEC=5
ALIYUN_ASR_HOTWORDS=
ALIYUN_ASR_CORRECTIONS=
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_GREEN_VIDEO_SERVICE=videoDetection
ALIYUN_GREEN_TIMEOUT_SEC=300
ALIYUN_GREEN_POLL_INTERVAL_SEC=5
ALIYUN_VIDEO_DETECT_MODE=vl
ALIYUN_VIDEO_MODEL=qwen3-vl-flash
ALIYUN_VIDEO_REQUEST_TIMEOUT_SEC=120
